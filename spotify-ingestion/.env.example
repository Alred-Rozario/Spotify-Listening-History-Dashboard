# Copy this file to ".env" (same folder) and fill in. ".env" is git-ignored.
# Only the person running enrichment (Member 1) needs these. Teammates can skip this file entirely.

# Spotify (https://developer.spotify.com/dashboard) - app owner must have Premium.
# Add this exact Redirect URI in the app settings: http://127.0.0.1:8888/callback
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# "user" = browser login once (default), "client" = no login (may be rejected by Spotify now)
SPOTIFY_AUTH=user

# Optional: free key from https://www.last.fm/api/account/create  (used for genres)
LASTFM_API_KEY=

# Timezone used for hour-of-day / day-of-week columns (Spotify exports are in UTC)
LOCAL_TZ=Asia/Kolkata
